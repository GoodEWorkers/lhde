---
import Base from '../../layouts/Base.astro';
import { languages, useTranslations, type Lang } from '../../i18n/utils';
import { glossary, categoryLabels, type Term } from '../../data/glossary';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const terms = [...glossary[lang]].sort((a, b) => a.term.localeCompare(b.term, lang));
const labels = categoryLabels[lang];
const byId = new Map(terms.map((term) => [term.id, term]));
const categories = [...new Set(terms.map((term) => term.category))] as Term['category'][];

const tone: Record<Term['category'], string> = {
  reeif: 'text-orange border-orange/40',
  exchange: 'text-yellow border-yellow/40',
  semantics: 'text-purple border-purple/40',
  profiling: 'text-[#7fb3d5] border-[#7fb3d5]/40',
  architecture: 'text-[#6fcf97] border-[#6fcf97]/40',
  ecosystem: 'text-ashgray border-white/30',
};
---

<Base title={t('glossary.title')} description={t('glossary.lede')}>
  <section class="container-x py-14 md:py-20">
    <p class="eyebrow">{t('nav.glossary')}</p>
    <h1 class="mt-4 max-w-3xl font-clash text-4xl leading-[1.08] text-white md:text-6xl">
      {t('glossary.title')}
    </h1>
    <p class="mt-6 max-w-2xl leading-[1.7] text-midgray">{t('glossary.lede')}</p>

    <div class="mt-10 flex flex-wrap items-center gap-3" data-glossary-controls>
      <label class="sr-only" for="glossary-search">{t('glossary.search')}</label>
      <input
        id="glossary-search"
        type="search"
        placeholder={t('glossary.search')}
        autocomplete="off"
        class="w-full max-w-sm rounded-full border border-white/20 bg-black-light px-5 py-3 text-sm text-white placeholder:text-midgray focus:border-orange focus:outline-none"
        data-glossary-search
      />
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="rounded-full border border-orange bg-orange px-3 py-1.5 text-xs font-bold text-black aria-pressed:bg-orange"
        >
          {lang === 'fr' ? 'Tout' : 'All'}
        </button>
        {
          categories.map((c) => (
            <button
              type="button"
              data-filter={c}
              aria-pressed="false"
              class={`rounded-full border px-3 py-1.5 text-xs font-bold transition-colors hover:text-white ${tone[c]}`}
            >
              {labels[c]}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-x pb-24">
    <dl class="grid gap-3 md:grid-cols-2 lg:grid-cols-3" data-glossary-list>
      {
        terms.map((term) => (
          <div
            class="flex flex-col rounded-2xl bg-black-light p-6"
            id={`term-${term.id}`}
            data-term
            data-category={term.category}
            data-search={`${term.term} ${term.definition}`.toLowerCase()}
          >
            <span class={`self-start rounded-full border px-2.5 py-0.5 text-[0.65rem] font-bold uppercase ${tone[term.category]}`}>
              {labels[term.category]}
            </span>
            <dt class="mt-3 font-clash text-xl text-white">{term.term}</dt>
            <dd class="mt-3 text-sm leading-relaxed text-midgray">{term.definition}</dd>
            {term.seeAlso && term.seeAlso.length > 0 && (
              <p class="mt-4 text-xs text-midgray">
                <span class="font-bold text-ashgray">{t('glossary.seealso')} : </span>
                {term.seeAlso
                  .map((id) => byId.get(id))
                  .filter((x): x is Term => Boolean(x))
                  .map((related, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`#term-${related.id}`} class="text-orange hover:underline">
                        {related.term}
                      </a>
                    </>
                  ))}
              </p>
            )}
          </div>
        ))
      }
    </dl>

    <p class="mt-10 hidden text-center text-midgray" data-glossary-empty>{t('glossary.empty')}</p>
  </section>
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-glossary-search]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-term]')];
  const empty = document.querySelector<HTMLElement>('[data-glossary-empty]');

  let category = 'all';

  const render = () => {
    const query = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;

    cards.forEach((card) => {
      const matchesCategory = category === 'all' || card.dataset.category === category;
      const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
      const visible = matchesCategory && matchesQuery;
      card.hidden = !visible;
      if (visible) shown += 1;
    });

    empty?.classList.toggle('hidden', shown > 0);
  };

  search?.addEventListener('input', render);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      category = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-orange', active && b.dataset.filter === 'all');
        b.classList.toggle('text-black', active && b.dataset.filter === 'all');
        b.classList.toggle('ring-2', active);
        b.classList.toggle('ring-current', active);
      });
      render();
    });
  });

  render();
</script>
