---
import Base from '../layouts/Base.astro';
import { defaultLang, localePath } from '../i18n/utils';
---

<Base title="404">
  <section class="container-x flex min-h-[60vh] flex-col justify-center py-20">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 max-w-3xl font-clash text-4xl leading-[1.08] text-white md:text-6xl">
      Cette page n’existe pas — This page does not exist
    </h1>
    <p class="mt-6 max-w-2xl text-midgray">
      Le lien est peut-être obsolète, ou la langue absente de l’URL.<br />
      The link may be outdated, or the locale missing from the URL.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={localePath(defaultLang, 'modules')} class="pill-orange">Parcours — Français</a>
      <a href={localePath('en', 'modules')} class="pill-ghost">Pathway — English</a>
    </div>
  </section>
</Base>
