---
export interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<div class="not-prose my-12">
  <ol class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li class="flex flex-col rounded-2xl bg-black-light p-5">
          <span class="font-clash text-3xl leading-none font-bold text-orange">{i + 1}</span>
          <h4 class="mt-3 font-clash text-base text-white">{step.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-midgray">{step.body}</p>
        </li>
      ))
    }
  </ol>
  {caption && <p class="mt-5 text-center text-sm text-midgray italic">{caption}</p>}
</div>
