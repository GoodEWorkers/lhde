---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export interface MatchOption {
  id: string;
  label: string;
}

export interface MatchItem {
  /** The situation the learner must classify. */
  text: string;
  /** `id` of the expected option. */
  answer: string;
  /** Optional one-line justification revealed with the answer. */
  note?: string;
}

interface Props {
  id: string;
  title?: string;
  instruction?: string;
  options: MatchOption[];
  items: MatchItem[];
}

const { id, title, instruction, options, items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const optionLabel = Object.fromEntries(options.map((o) => [o.id, o.label]));
---

<section
  class="not-prose my-12 rounded-2xl border border-purple/30 bg-black-light p-6 md:p-8"
  data-match
  data-match-id={id}
  aria-labelledby={`${id}-title`}
>
  <p class="eyebrow text-purple">{t('activity.label')}</p>
  <h3 id={`${id}-title`} class="mt-2 font-clash text-2xl text-white md:text-3xl">
    {title ?? t('sorter.title')}
  </h3>
  <p class="mt-3 max-w-2xl text-sm text-midgray">{instruction ?? t('sorter.instruction')}</p>

  <ol class="mt-8 space-y-4">
    {
      items.map((item, i) => (
        <li
          class="rounded-xl border border-white/10 bg-black-soft p-4 md:p-5"
          data-item
          data-answer={item.answer}
          data-note={item.note ?? ''}
        >
          <p class="text-sm text-white md:text-base">
            <span class="mr-2 font-clash font-bold text-purple">{String.fromCharCode(65 + i)}.</span>
            {item.text}
          </p>

          <div class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-label={item.text}>
            {options.map((option) => (
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-choice
                data-value={option.id}
                class="rounded-full border border-white/20 px-3 py-1.5 text-xs font-bold text-ashgray transition-colors hover:border-purple hover:text-white aria-checked:border-purple aria-checked:bg-purple aria-checked:text-black"
              >
                {option.label}
              </button>
            ))}
          </div>

          <p class="mt-3 hidden text-sm" data-feedback />
        </li>
      ))
    }
  </ol>

  <div class="mt-8 flex flex-wrap gap-4">
    <button type="button" class="pill-purple text-sm" data-reveal>{t('sorter.reveal')}</button>
    <button type="button" class="pill-ghost text-sm" data-reset>{t('sorter.reset')}</button>
  </div>

  <template
    data-labels
    data-right={t('sorter.right')}
    data-wrong={t('sorter.wrong')}
    data-map={JSON.stringify(optionLabel)}></template>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-match]').forEach((activity) => {
    const meta = activity.querySelector<HTMLElement>('[data-labels]')!;
    const rightLabel = meta.dataset.right ?? 'Right';
    const wrongLabel = meta.dataset.wrong ?? 'Expected';
    const map: Record<string, string> = JSON.parse(meta.dataset.map ?? '{}');
    const items = [...activity.querySelectorAll<HTMLElement>('[data-item]')];

    items.forEach((item) => {
      item.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((btn) => {
        btn.addEventListener('click', () => {
          item
            .querySelectorAll<HTMLButtonElement>('[data-choice]')
            .forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
        });
      });
    });

    activity.querySelector<HTMLButtonElement>('[data-reveal]')!.addEventListener('click', () => {
      items.forEach((item) => {
        const expected = item.dataset.answer!;
        const picked = item.querySelector<HTMLButtonElement>('[data-choice][aria-checked="true"]');
        const feedback = item.querySelector<HTMLElement>('[data-feedback]')!;
        const ok = picked?.dataset.value === expected;
        const note = item.dataset.note ? ` — ${item.dataset.note}` : '';

        feedback.textContent = ok ? `✓ ${rightLabel} : ${map[expected]}${note}` : `→ ${wrongLabel} : ${map[expected]}${note}`;
        feedback.className = `mt-3 text-sm ${ok ? 'text-emerald-400' : 'text-yellow'}`;

        item.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b) => {
          if (b.dataset.value === expected) b.classList.add('ring-2', 'ring-emerald-400');
        });
      });
    });

    activity.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
      items.forEach((item) => {
        item.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((b) => {
          b.setAttribute('aria-checked', 'false');
          b.classList.remove('ring-2', 'ring-emerald-400');
        });
        const feedback = item.querySelector<HTMLElement>('[data-feedback]')!;
        feedback.textContent = '';
        feedback.className = 'mt-3 hidden text-sm';
      });
    });
  });
</script>
