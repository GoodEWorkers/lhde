---
export interface Card {
  title: string;
  body: string;
  tag?: string;
}

interface Props {
  cards: Card[];
  columns?: 2 | 3 | 4;
  caption?: string;
}

const { cards, columns = 3, caption } = Astro.props;
const cols = { 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[columns];
---

<div class="not-prose my-12">
  <div class:list={['grid gap-3', cols]}>
    {
      cards.map((card) => (
        <div class="flex flex-col rounded-2xl bg-black-light p-6 transition-colors hover:bg-black-soft">
          {card.tag && <p class="font-clash text-xs font-bold tracking-[0.18em] text-orange uppercase">{card.tag}</p>}
          <h4 class="mt-2 font-clash text-lg text-white">{card.title}</h4>
          <p class="mt-3 text-sm leading-relaxed text-midgray">{card.body}</p>
        </div>
      ))
    }
  </div>
  {caption && <p class="mt-5 text-center text-sm text-midgray italic">{caption}</p>}
</div>
